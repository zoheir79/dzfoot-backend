# GF Worker environment for VM 102.220.31.37 (private: 192.168.199.112)
# Place this file on the GF VM and source it before running the worker

# Backend VM private IP
BACKEND_PRIVATE_IP=192.168.199.134

# Redis queue (backend VM)
REDIS_URL=redis://${BACKEND_PRIVATE_IP}:6379

# Stats service (backend VM)
STATS_URL=http://${BACKEND_PRIVATE_IP}:8004

# LiveKit (external)
LIVEKIT_URL=https://orch.adexgenie.ai

# Compiled GF binary path on this VM
GF_BINARY_PATH=/usr/local/bin/gf_server

# Worker identity
HOSTNAME=gf-worker-vm2
