# DZFoot Environment Variables
# Copy to .env and fill in your values

# LiveKit (ta plateforme existante)
LIVEKIT_URL=wss://your-livekit-domain.com
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# App
APP_SECRET_KEY=change_this_to_random_string_32_chars

# PostgreSQL (via Docker Compose)
POSTGRES_USER=dzfoot
POSTGRES_PASSWORD=dzfoot
POSTGRES_DB=dzfoot

# Redis (via Docker Compose)
REDIS_URL=redis://redis:6379

# GameplayFootball spawn mode
# "local" = subprocess on same machine (dev/single-node)
# "queue" = publish to Redis for GF worker VM pool (prod/scaling)
GF_SPAWN_MODE=local
GF_BINARY_PATH=/usr/local/bin/gf_server

# Circuit timeouts (seconds)
GF_SPAWN_TIMEOUT=30        # Max wait for GF ready signal
GF_MATCH_TIMEOUT=900       # Max match duration + buffer before forced kill

# Inter-service URLs
STATS_SERVICE_URL=http://stats:8000
SESSION_URL=http://session:8000
ACCOUNT_URL=http://account:8000

# Admin Panel
ADMIN_PORT=8006
ADMIN_SECRET=change_this_admin_secret_key

# GF Worker (cross-VM)
# Set GF_SPAWN_MODE=queue when GF server runs on a separate VM
GF_SPAWN_MODE=queue
GF_BINARY_PATH=/usr/local/bin/gf_server
